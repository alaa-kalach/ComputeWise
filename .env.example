# Copy to .env (never commit .env) and fill in.

# ---- Database (Person 1, A1) ------------------------------------------------
# Supabase dashboard -> Connect (top of the page) -> Direct tab -> Session pooler (port 5432).
# Copy the whole string; the host cannot be guessed from the region. Don't use
# "Direct connection": it needs IPv6, which many home/university networks lack.
# Replace [YOUR-PASSWORD] with the database password, without the brackets.
# Paste it as-is: postgresql://... is switched to the psycopg driver automatically.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host-copied-from-supabase>:5432/postgres

# ---- Encryption (Person 1, A1/A3) -------------------------------------------
# Fernet key for provider secrets at rest. Generate: cd backend && python -m app.core.crypto
# Everyone sharing one database must use the SAME key, or seeded secrets won't decrypt.
FERNET_KEY=

# ---- Supabase Auth (Person 1, A2) -------------------------------------------
# Project URL: Supabase project home page (top, with a Copy button).
SUPABASE_URL=https://<project-ref>.supabase.co
# Leave empty unless the project still uses the legacy JWT secret (HS256).
SUPABASE_JWT_SECRET=
# Frontend origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173

# ---- Frontend (Person 3) ------------------------------------------------------
# Safe to expose in the browser. Supabase -> Project Settings -> API Keys -> Publishable key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---- Tests ------------------------------------------------------------------
# A SEPARATE database: tests drop and recreate its tables. Never the shared one.
TEST_DATABASE_URL=
